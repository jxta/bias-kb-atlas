{
 "name": "bias-kb-atlas",
 "image": "mcr.microsoft.com/devcontainers/python:3.12",
 "postCreateCommand": "pip install -r requirements.txt jupyterlab && python3 rerun.py",
 "customizations": {
  "vscode": {
   "extensions": [
    "ms-python.python",
    "ms-toolsai.jupyter"
   ]
  }
 },
 "forwardPorts": [
  8000
 ],
 "portsAttributes": {
  "8000": {
   "label": "Atlas (python3 -m http.server 8000)"
  }
 }
}