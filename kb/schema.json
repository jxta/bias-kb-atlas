{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "lrr:kb-schema-v1",
 "title": "bias-kb node schema v1.3 (提案0010 + sha_verified/related + direction/verdict/ledger + status_history)",
 "$comment": "v1.1 (2026-08-23, meta 検収): STATU 0065/0066 の提案を採択し artifacts/inputs に sha_verified を追補（annex 実ファイル照合の運用表現）。related（研究線横断の概念連結、kb_build REL_FIELDS 対応）を宣言。他は v1 から不変。 v1.2 (2026-09-06, ORDER 0014): direction・verdict・ledger を宣言（純加算、required は増やさない）。従来これらは未宣言のまま使われていた（direction）か、散文と文字列にしかなかった（verdict・台帳）。 v1.3 (2026-09-07, ORDER 0015 §3): status_history を宣言（純加算、required は増やさない）。新規 C/H のみ必須で既存は遡及しない。",
 "type": "object",
 "required": [
  "id",
  "type",
  "label",
  "prov"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[OQECHPXL]-[a-z0-9][a-z0-9-]*$"
  },
  "type": {
   "enum": [
    "Object",
    "Quantity",
    "Evidence",
    "Claim",
    "Hypothesis",
    "Protocol",
    "ExecutionUnit",
    "Lesson"
   ]
  },
  "label": {
   "type": "string",
   "maxLength": 200
  },
  "direction": {
   "type": "string",
   "$comment": "研究線（A / B / …）。俯瞰ビューと予測台帳の集計単位。研究線の新設は横山の決定事項なので enum にしない。"
  },
  "statement": {
   "type": "string"
  },
  "status": {
   "enum": [
    "established",
    "registered-hit",
    "rejected-recorded",
    "provisional",
    "superseded",
    "open",
    "supported",
    "challenged",
    "promoted",
    "rejected"
   ]
  },
  "status_history": {
   "type": "array",
   "$comment": "主張・仮説の状態遷移（ORDER 0015 §3-2）。status を変えるときに 1 行足す。最後の要素の status は現在の status と一致していなければならない。既存ノードは遡及しない（空でよい）。",
   "items": {
    "type": "object",
    "required": [
     "status",
     "date"
    ],
    "additionalProperties": false,
    "properties": {
     "status": {
      "$ref": "#/properties/status"
     },
     "date": {
      "type": "string"
     },
     "by": {
      "type": "string",
      "$comment": "agents.json の @id（agent:statu など）"
     },
     "evidence": {
      "type": "string",
      "pattern": "^E-",
      "$comment": "この遷移を起こした証拠"
     },
     "protocol": {
      "type": "string",
      "pattern": "^P-"
     },
     "pr": {
      "type": "string"
     },
     "statu": {
      "type": "string"
     },
     "reason": {
      "type": "string"
     },
     "derived": {
      "type": "boolean",
      "$comment": "派生で補った擬似履歴の印（ノードには書かない。派生物側でのみ使う）"
     }
    }
   }
  },
  "counterpoints": {
   "type": "string"
  },
  "about": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^O-"
   }
  },
  "quantities": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^Q-"
   }
  },
  "supported_by": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^E-"
   }
  },
  "refuted_by": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^E-"
   }
  },
  "registered_by": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^P-"
   }
  },
  "derives_from": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "supersedes": {
   "type": "string"
  },
  "promoted_to": {
   "type": "string",
   "pattern": "^C-"
  },
  "derivation_hooks": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "related": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "values": {
   "type": "object"
  },
  "measures": {
   "type": "object",
   "properties": {
    "quantity": {
     "pattern": "^Q-"
    },
    "on": {
     "pattern": "^O-"
    }
   }
  },
  "artifacts": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "path",
     "role"
    ],
    "properties": {
     "path": {
      "type": "string"
     },
     "sha256": {
      "type": "string"
     },
     "sha_kind": {
      "enum": [
       "raw",
       "content"
      ]
     },
     "location": {
      "enum": [
       "repo",
       "annex"
      ]
     },
     "role": {
      "type": "string"
     },
     "sha_verified": {
      "enum": [
       "verified",
       "recorded-only"
      ]
     }
    }
   }
  },
  "grounded_in": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^X-"
   }
  },
  "supports": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[CH]-"
   }
  },
  "refutes": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[CH]-"
   }
  },
  "tier": {
   "enum": [
    "full",
    "accept",
    "spot"
   ]
  },
  "entry": {
   "type": "string"
  },
  "inputs": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "ref"
    ],
    "properties": {
     "ref": {
      "type": "string"
     },
     "sha256": {
      "type": "string"
     },
     "sha_kind": {
      "enum": [
       "raw",
       "content"
      ]
     },
     "sha_verified": {
      "enum": [
       "verified",
       "recorded-only"
      ]
     }
    }
   }
  },
  "expected": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "tolerance"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "value": {},
     "sha256": {
      "type": "string"
     },
     "tolerance": {
      "type": "string"
     }
    }
   }
  },
  "env": {
   "type": "object"
  },
  "independence": {
   "type": "string"
  },
  "seed": {
   "type": [
    "string",
    "integer"
   ]
  },
  "verifies": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^E-"
   }
  },
  "notebook": {
   "type": "string"
  },
  "definition": {
   "type": "string"
  },
  "convention": {
   "type": "string"
  },
  "lmfdb_label": {
   "type": "string"
  },
  "sameAs": {
   "type": "string",
   "format": "uri"
  },
  "frozen": {
   "type": "object",
   "properties": {
    "sha256": {
     "type": "string"
    },
    "frozen_at": {
     "type": "string"
    },
    "pr": {
     "type": "string"
    },
    "path": {
     "type": "string"
    }
   }
  },
  "taught_by": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "constrains": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "prov": {
   "type": "object",
   "required": [
    "asserted_by",
    "date"
   ],
   "properties": {
    "asserted_by": {
     "type": "string"
    },
    "accepted_by": {
     "type": "string"
    },
    "statu": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "pr": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "date": {
     "type": "string"
    },
    "independent_paths": {
     "type": "integer"
    },
    "visibility": {
     "enum": [
      "internal",
      "bias-shared",
      "public"
     ]
    }
   }
  },
  "outcome_space": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "var",
     "domain"
    ],
    "additionalProperties": false,
    "properties": {
     "var": {
      "type": "string"
     },
     "domain": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "string"
      }
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "decision_table": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "when",
     "verdict"
    ],
    "additionalProperties": false,
    "properties": {
     "when": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     },
     "verdict": {
      "type": "string"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "discriminants": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "name",
     "statistic",
     "kind",
     "band",
     "band_source"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "statistic": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "band",
       "exist",
       "desc"
      ]
     },
     "band": {
      "type": "string"
     },
     "band_source": {
      "type": "string"
     },
     "power": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "halfw": {
        "type": "number"
       },
       "se_forecast": {
        "type": "number"
       },
       "sigma": {
        "type": "number"
       },
       "source": {
        "type": "string"
       },
       "gate": {
        "type": "string"
       }
      }
     },
     "decision": {
      "type": "string"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "null_model": {
   "type": "object",
   "required": [
    "sampling_unit",
    "sd_source"
   ],
   "additionalProperties": false,
   "properties": {
    "sampling_unit": {
     "type": "string"
    },
    "sd_source": {
     "type": "string"
    },
    "calibrated_by": {
     "type": "string"
    },
    "nboot": {
     "type": "integer"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "sample": {
   "type": "object",
   "required": [
    "cohort_sha",
    "n_fields"
   ],
   "additionalProperties": false,
   "properties": {
    "cohort_sha": {
     "type": "string"
    },
    "n_fields": {
     "type": "integer"
    },
    "n_cohorts": {
     "type": "integer"
    },
    "band": {
     "type": "string"
    },
    "selection": {
     "type": "string"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "exposure": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "verdict": {
   "$comment": "凍結判定の結果（ORDER 0014）。**旧形式は自然文の文字列**（P の \"★… → E-…\"、記録層に実在する）。新規ノードは object 形式で書く（kb_ledger.py --check が期限以降に要求）。既存ノードを 1 つも落とさないため両方を許す。",
   "oneOf": [
    {
     "type": "string",
     "$comment": "旧形式。kb_ledger.py が name/qualifier/k/n/evidence に分解して読む"
    },
    {
     "type": "object",
     "required": [
      "name"
     ],
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string",
       "$comment": "★SERIES CONFIRMED / INSTRUMENT FAIL / ★CLAIMS CONFIRMED など、判定表の行の名前だけ"
      },
      "qualifier": {
       "type": "string",
       "$comment": "INCONCLUSIVE 付き など"
      },
      "k": {
       "type": "integer",
       "minimum": 0,
       "$comment": "k/n 形式の判定名の分子"
      },
      "n": {
       "type": "integer",
       "minimum": 0
      },
      "decision_row": {
       "type": "string",
       "$comment": "判定表の何行目に当たるか"
      },
      "predicted": {
       "type": "string",
       "$comment": "登録時の予測（P.verdict と同じ語彙）"
      },
      "matched": {
       "type": "boolean",
       "$comment": "凍結判定が登録の予測と一致したか"
      },
      "grade": {
       "enum": [
        "independent",
        "chain",
        "instrument-only",
        "none"
       ],
       "$comment": "★独立確証 / 鎖の一段 / 計器のみ / 等級なし。等級の裁定は横山の事項"
      },
      "protocol": {
       "type": "string",
       "pattern": "^P-"
      },
      "evidence": {
       "type": "string",
       "pattern": "^E-"
      },
      "date": {
       "type": "string"
      },
      "decided": {
       "type": "boolean",
       "$comment": "★判定表のその行が**何かを決めたか**（META 裁定 巡回231 §1 の (A)）。false ＝ 何も決めていない（★分解能不足・DEGRADED・INSTRUMENT FAIL のような行）。true ＝ 決めた（CLAIMS CONFIRMED・CLAIMS FALSIFIED など、支えた/覆した相手を名指せる行）。★`k` を『何も決めていない』の代理に使ってはいけない —— main の実データで `k` は (i) 決着した判別量の本数（E-c7 の CLAIMS FALSIFIED 1/1 は k=1）と (ii) 的中数（E-b6 の ★分解能不足 は k=0）の**どちらとも読め**、schema はどちらとも言っていない。(ii) の読みだと **反証した判定（P-b6 の判定表 行 6 など）も matched:false・k:0 になり、『意図的に空』の免除に入ってしまう**。`decided` はその曖昧さの外にある。"
      }
     }
    }
   ]
  },
  "ledger": {
   "type": "object",
   "$comment": "予測台帳の累積（この判定の時点）。counted:false は「台帳外」（記録のみ・探索）。",
   "required": [
    "counted"
   ],
   "additionalProperties": false,
   "properties": {
    "counted": {
     "type": "boolean"
    },
    "direction": {
     "type": "string"
    },
    "instrument": {
     "$ref": "#/$defs/tally"
    },
    "mechanism": {
     "$ref": "#/$defs/tally"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "supports_refutes": {
   "enum": [
    "none"
   ],
   "$comment": "★「意図的に空」の機械可読な宣言（META 裁定 巡回228 §4）。supports / refutes が両方とも空配列で、何も支えず何も覆していないことを**書いた**と示す。これが無ければ『まだ書いていない』と区別できない。kb_g4 は (a) 両欄が存在し両方空 (b) この欄が \"none\" (c) supports_refutes_note が非空 (d) object 形式 verdict で matched:false かつ k==0 の**全部**を満たすときだけ error にしない。"
  },
  "supports_refutes_note": {
   "type": "string",
   "minLength": 1,
   "$comment": "★なぜ空なのかの理由。空文字は不可（理由の無い免除を作らない）。"
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "type": {
      "const": "Claim"
     }
    }
   },
   "then": {
    "required": [
     "statement",
     "status",
     "counterpoints",
     "supported_by"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "type": {
      "const": "Hypothesis"
     }
    }
   },
   "then": {
    "required": [
     "statement",
     "status"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "type": {
      "const": "Evidence"
     }
    }
   },
   "then": {
    "required": [
     "values",
     "artifacts",
     "grounded_in"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "type": {
      "const": "ExecutionUnit"
     }
    }
   },
   "then": {
    "required": [
     "tier",
     "entry",
     "inputs",
     "expected",
     "env",
     "verifies"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "type": {
      "const": "Protocol"
     }
    }
   },
   "then": {
    "required": [
     "frozen"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "type": {
      "const": "Quantity"
     }
    }
   },
   "then": {
    "required": [
     "definition"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "type": {
      "const": "Lesson"
     }
    }
   },
   "then": {
    "required": [
     "statement",
     "taught_by"
    ]
   }
  }
 ],
 "$defs": {
  "tally": {
   "type": "object",
   "required": [
    "hit",
    "n"
   ],
   "additionalProperties": false,
   "properties": {
    "hit": {
     "type": "integer",
     "minimum": 0
    },
    "n": {
     "type": "integer",
     "minimum": 0
    }
   }
  }
 }
}
