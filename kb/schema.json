{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "lrr:kb-schema-v1",
 "title": "bias-kb node schema v1.1 (提案0010 + sha_verified/related 追補)",
 "$comment": "v1.1 (2026-08-23, meta 検収): STATU 0065/0066 の提案を採択し artifacts/inputs に sha_verified を追補（annex 実ファイル照合の運用表現）。related（研究線横断の概念連結、kb_build REL_FIELDS 対応）を宣言。他は v1 から不変。",
 "type": "object",
 "required": ["id", "type", "label", "prov"],
 "properties": {
  "id": {"type": "string", "pattern": "^[OQECHPXL]-[a-z0-9][a-z0-9-]*$"},
  "type": {"enum": ["Object", "Quantity", "Evidence", "Claim", "Hypothesis", "Protocol", "ExecutionUnit", "Lesson"]},
  "label": {"type": "string", "maxLength": 200},
  "statement": {"type": "string"},
  "status": {"enum": ["established", "registered-hit", "rejected-recorded", "provisional", "superseded", "open", "supported", "challenged", "promoted", "rejected"]},
  "counterpoints": {"type": "string"},
  "about": {"type": "array", "items": {"type": "string", "pattern": "^O-"}},
  "quantities": {"type": "array", "items": {"type": "string", "pattern": "^Q-"}},
  "supported_by": {"type": "array", "items": {"type": "string", "pattern": "^E-"}},
  "refuted_by": {"type": "array", "items": {"type": "string", "pattern": "^E-"}},
  "registered_by": {"type": "array", "items": {"type": "string", "pattern": "^P-"}},
  "derives_from": {"type": "array", "items": {"type": "string"}},
  "supersedes": {"type": "string"},
  "promoted_to": {"type": "string", "pattern": "^C-"},
  "derivation_hooks": {"type": "array", "items": {"type": "string"}},
  "related": {"type": "array", "items": {"type": "string"}},
  "values": {"type": "object"},
  "measures": {"type": "object", "properties": {"quantity": {"pattern": "^Q-"}, "on": {"pattern": "^O-"}}},
  "artifacts": {"type": "array", "items": {"type": "object", "required": ["path", "role"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string"}, "sha_kind": {"enum": ["raw", "content"]}, "location": {"enum": ["repo", "annex"]}, "role": {"type": "string"}, "sha_verified": {"enum": ["verified", "recorded-only"]}}}},
  "grounded_in": {"type": "array", "items": {"type": "string", "pattern": "^X-"}},
  "supports": {"type": "array", "items": {"type": "string", "pattern": "^[CH]-"}},
  "refutes": {"type": "array", "items": {"type": "string", "pattern": "^[CH]-"}},
  "tier": {"enum": ["full", "accept", "spot"]},
  "entry": {"type": "string"},
  "inputs": {"type": "array", "items": {"type": "object", "required": ["ref"], "properties": {"ref": {"type": "string"}, "sha256": {"type": "string"}, "sha_kind": {"enum": ["raw", "content"]}, "sha_verified": {"enum": ["verified", "recorded-only"]}}}},
  "expected": {"type": "array", "items": {"type": "object", "required": ["name", "tolerance"], "properties": {"name": {"type": "string"}, "value": {}, "sha256": {"type": "string"}, "tolerance": {"type": "string"}}}},
  "env": {"type": "object"},
  "independence": {"type": "string"},
  "seed": {"type": ["string", "integer"]},
  "verifies": {"type": "array", "items": {"type": "string", "pattern": "^E-"}},
  "notebook": {"type": "string"},
  "definition": {"type": "string"},
  "convention": {"type": "string"},
  "lmfdb_label": {"type": "string"},
  "sameAs": {"type": "string", "format": "uri"},
  "frozen": {"type": "object", "properties": {"sha256": {"type": "string"}, "frozen_at": {"type": "string"}, "pr": {"type": "string"}, "path": {"type": "string"}}},
  "taught_by": {"type": "array", "items": {"type": "string"}},
  "constrains": {"type": "array", "items": {"type": "string"}},
  "prov": {"type": "object", "required": ["asserted_by", "date"], "properties": {"asserted_by": {"type": "string"}, "accepted_by": {"type": "string"}, "statu": {"type": "array", "items": {"type": "string"}}, "pr": {"type": "array", "items": {"type": "string"}}, "date": {"type": "string"}, "independent_paths": {"type": "integer"}, "visibility": {"enum": ["internal", "bias-shared", "public"]}}}
 },
 "allOf": [
  {"if": {"properties": {"type": {"const": "Claim"}}}, "then": {"required": ["statement", "status", "counterpoints", "supported_by"]}},
  {"if": {"properties": {"type": {"const": "Hypothesis"}}}, "then": {"required": ["statement", "status"]}},
  {"if": {"properties": {"type": {"const": "Evidence"}}}, "then": {"required": ["values", "artifacts", "grounded_in"]}},
  {"if": {"properties": {"type": {"const": "ExecutionUnit"}}}, "then": {"required": ["tier", "entry", "inputs", "expected", "env", "verifies"]}},
  {"if": {"properties": {"type": {"const": "Protocol"}}}, "then": {"required": ["frozen"]}},
  {"if": {"properties": {"type": {"const": "Quantity"}}}, "then": {"required": ["definition"]}},
  {"if": {"properties": {"type": {"const": "Lesson"}}}, "then": {"required": ["statement", "taught_by"]}}
 ]
}
