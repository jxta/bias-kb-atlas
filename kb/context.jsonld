   "@id": "lrr:taughtBy",
   "@type": "@id"
  },
  "constrains": {
   "@id": "lrr:constrains",
   "@type": "@id"
  },
  "uses": {
   "@id": "lrr:uses",
   "@type": "@id"
  },
  "sameAs": {
   "@id": "schema:sameAs",
   "@type": "@id"
  },
  "lmfdb_label": "lrr:lmfdbLabel",
