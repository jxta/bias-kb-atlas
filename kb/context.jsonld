    "name": "lrr:verdictName",
    "qualifier": "lrr:verdictQualifier",
    "k": "lrr:verdictK",
    "n": "lrr:verdictN",
    "decision_row": "lrr:decisionRow",
    "predicted": "lrr:predictedVerdict",
    "matched": "lrr:predictionMatched",
    "grade": "lrr:verdictGrade",
    "protocol": {
     "@id": "lrr:verdictProtocol",
     "@type": "@id"
    },
    "evidence": {
     "@id": "lrr:verdictEvidence",
     "@type": "@id"
    },
    "date": "w3prov:generatedAtTime"
   }
  },
  "ledger": {
   "@id": "lrr:ledger",
   "@context": {
    "counted": "lrr:ledgerCounted",
    "direction": "lrr:direction",
    "instrument": "lrr:instrumentTally",
    "mechanism": "lrr:mechanismTally",
    "hit": "lrr:tallyHit",
    "n": "lrr:tallyN",
    "note": "lrr:note"
   }
  },
  "Object": "lrr:Object",
  "Quantity": "lrr:Quantity",
  "Evidence": "lrr:Evidence",
  "Claim": "lrr:Claim",
