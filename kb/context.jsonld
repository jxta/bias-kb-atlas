   "@id": "lrr:statusHistory",
   "@container": "@list",
   "@context": {
    "status": "lrr:status",
    "date": "w3prov:generatedAtTime",
    "by": "w3prov:wasAttributedTo",
    "evidence": {
     "@id": "lrr:verdictEvidence",
     "@type": "@id"
    },
    "protocol": {
     "@id": "lrr:verdictProtocol",
     "@type": "@id"
    },
    "pr": "lrr:pullRequest",
    "statu": "lrr:statu",
    "reason": "lrr:reason",
    "derived": "lrr:derivedEntry"
   }
  },
  "counterpoints": "lrr:counterpoints",
  "definition": "lrr:definition",
  "convention": "lrr:convention",
  "values": {
   "@id": "lrr:values",
   "@type": "@json"
  },
  "measures": "lrr:measures",
  "quantity": {
   "@id": "lrr:quantity",
   "@type": "@id"
  },
  "on": {
   "@id": "lrr:on",
