   "@type": "@json"
  },
  "seed": "lrr:seed",
  "notebook": "lrr:notebook",
  "independence": "lrr:independence",
  "frozen": "lrr:frozen",
  "ref": "lrr:ref",
  "path": "lrr:path",
  "role": "lrr:role",
